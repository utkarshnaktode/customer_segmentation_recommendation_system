# Create the .gitignore file
@"
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
.ipynb_checkpoints/
*.nbconvert.ipynb
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.ico
*.bmp
*.mp4
*.avi
*.mov
build/
dist/
*.egg-info/
*.log
pip-log.txt
.pytest_cache/
.coverage
data/
data_raw/
*.csv
*.parquet
*.xlsx
.vscode/
.idea/
.env
.env.*
.DS_Store
Thumbs.db
"@ > .gitignore

# Add, commit, and push to dev
git add .gitignore
git commit -m "Add .gitignore (exclude venv, images, and data files)"
git push origin dev